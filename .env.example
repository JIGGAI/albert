ALBERT_POSTGRES_PASSWORD=replace-with-a-random-database-password
ALBERT_API_KEY_PEPPER=replace-with-at-least-32-random-characters
# Used only by local stdio MCP clients; HTTP MCP forwards each caller's bearer key.
ALBERT_MCP_API_KEY=
ALBERT_API_URL=http://api:8080
ALBERT_PUBLIC_BASE_URL=http://localhost:8080
ALBERT_API_BIND=127.0.0.1
ALBERT_MCP_BIND=127.0.0.1
ALBERT_INSTALL_SEMANTIC=false
ALBERT_EMBEDDING_PROVIDER=hashing
ALBERT_EMBEDDING_DIMENSIONS=384
ALBERT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ALBERT_EMBEDDING_REQUEST_DIMENSIONS=false
# Where the knowledge graph is stored: postgres (default), falkordb or neo4j. For falkordb,
# start Compose with `--profile falkordb`. See docs/GRAPH_BACKENDS.md.
ALBERT_GRAPH_STORE=postgres
# Explicitly choose regex, llm-classifier, or graphiti. Empty preserves the legacy
# inference (regex with no LLM, llm-classifier with an OpenAI-compatible LLM).
ALBERT_GRAPH_BUILDER=
ALBERT_FALKORDB_URL=redis://falkordb:6379
# For neo4j, start Compose with `--profile neo4j` and set a password.
ALBERT_NEO4J_URL=bolt://neo4j:7687
ALBERT_NEO4J_PASSWORD=
ALBERT_LLM_PROVIDER=none
ALBERT_OPENAI_BASE_URL=https://api.openai.com/v1
ALBERT_OPENAI_API_KEY=
ALBERT_CLASSIFICATION_MODEL=
# ALBERT_LLM_PROVIDER=chatgpt-oauth signs in with a ChatGPT account instead of an
# API key (`albert-admin chatgpt-login-start`). The file must be on storage every
# Albert process shares; see docs/GRAPH_BACKENDS.md.
ALBERT_CHATGPT_CREDENTIALS_FILE=
ALBERT_CHATGPT_REASONING_EFFORT=
# ALBERT_LLM_PROVIDER=openclaw classifies through an OpenClaw gateway agent and
# reuses OpenClaw's own model sign-in. Install the agent on the OpenClaw host with
# `albert-capture classifier-agent`; the token is gateway.auth.token in that
# host's openclaw.json. See docs/PROVIDERS.md.
ALBERT_OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
ALBERT_OPENCLAW_GATEWAY_TOKEN=
ALBERT_OPENCLAW_AGENT_ID=albert-classifier
ALBERT_MIN_VECTOR_SIMILARITY=0.2
# Keyword search matches any query term and keeps at most this many of the rarest.
ALBERT_LEXICAL_MAX_TERMS=8
# Memories are embedded as overlapping chunks of this many characters.
ALBERT_CHUNK_CHARACTERS=1500
ALBERT_CHUNK_OVERLAP_CHARACTERS=200
ALBERT_MAX_CHUNKS_PER_MEMORY=200
# Versioned standing-profile buckets map bucket names to supported memory types.
ALBERT_PROFILE_SCHEMA_VERSION=1
ALBERT_PROFILE_BUCKETS={"identity":["identity"],"preferences":["preference"],"goals":["goal"],"constraints":["constraint"]}
ALBERT_PROFILE_MAX_ASSERTIONS=100
ALBERT_LOG_LEVEL=INFO
# Flight recorder: fraction of ok traces kept (errors/degraded always kept) and retention.
ALBERT_TRACE_SAMPLE_RATE=1.0
ALBERT_TRACE_RETENTION_DAYS=14
# Operator key for the console service; issue with
#   albert-admin create-key --principal-id <console principal> --capabilities console.read
ALBERT_CONSOLE_API_KEY=
ALBERT_CONSOLE_BIND=127.0.0.1
ALBERT_CONSOLE_PORT=8082
# Host names the console answers to, comma-separated ("host" any port,
# "host:port" only that one). Add the name you publish it under, e.g.
# albert-console.internal.example.com; anything else is refused.
ALBERT_CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Memory map: links per memory, minimum cosine similarity for a link, and how
# often the worker turns new traces into recall statistics.
ALBERT_LINK_NEIGHBORS=5
ALBERT_LINK_SIMILARITY_MIN=0.78
ALBERT_HOUSEKEEPING_SECONDS=60
ALBERT_MAP_NODE_LIMIT=1500
